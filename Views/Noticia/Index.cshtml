@model List<Noticia>

<div class="container mt-5" style="max-width: 800px;">
    <h2 class="mb-4 border-bottom pb-2 fw-bold text-uppercase" style="font-family: 'Georgia', serif;">
        Últimas Noticias
    </h2>
    
    <div class="list-group list-group-flush">
        @foreach (var noticia in Model)
        {
            <article class="py-3 border-bottom position-relative hover-news">
                <div class="row align-items-center g-3">

                    <div class="col-4 col-sm-3 col-md-2">
                        <div class="ratio ratio-1x1 shadow-sm overflow-hidden rounded">
                            <img src="@noticia.Imagen"
                                 class="object-fit-cover"
                                 alt="@noticia.Titulo"
                                 onerror="this.src='https://placehold.co/200x200?text=Noticia'">
                        </div>
                    </div>

                    <div class="col-8 col-sm-9 col-md-10">
                        <div class="d-flex flex-column h-100">
                            <small class="text-danger fw-bold text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                @noticia.Tipo
                            </small>

                            <h5 class="mb-1 fw-bold" style="font-family: 'Georgia', serif; line-height: 1.2;">
                                <a href="@Url.Action("Mostrar", "Noticia", new { id = noticia.Id })"
                                   class="text-dark text-decoration-none stretched-link">
                                    @noticia.Titulo
                                </a>
                            </h5>

                            <div class="mt-auto">
                                <small class="text-muted small">
                                    <i class="bi bi-clock-history me-1"></i>
                                    @noticia.Fecha.ToShortDateString()
                                </small>
                            </div>
                        </div>
                    </div>

                </div>
            </article>
        }
    </div>
</div>

<style>
    /* Estilo para el efecto de selección suave */
    .hover-news {
        transition: background-color 0.2s ease;
    }

        .hover-news:hover {
            background-color: #f8f9fa;
        }

    /* Asegurar que la imagen sea cuadrada y cubra el espacio */
    .object-fit-cover {
        object-fit: cover;
        width: 100%;
        height: 100%;
    }

    /* Ajuste de tipografía estilo periódico */
    h5 a {
        font-size: 1.15rem;
    }

        h5 a:hover {
            color: #000;
        }
</style>



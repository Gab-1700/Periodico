@{
    ViewData["Title"] = "El Deber";
}

<section class="noticia-economia">
    <h2>
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Noticia1">Alerta por Baja Presión en la Zona Norte</a>
    </h2>
    <p>
        Contenido: SAGUAPAC informa sobre cortes programados de agua potable en la zona norte debido a trabajos de
        mantenimiento en la red principal. Se recomienda a los vecinos almacenar el líquido. La normalización del
        servicio será gradual.
    </p>
</section>
<section class="noticia-deportes">
    <h2>
        
        <a class="navbar-brand" href="/Home/Noticia1" >Real Madrid</a>
    </h2>
    <p>
        Contenido: El equipo de Blooming se impuso 2-1 a Oriente Petrolero en un emocionante Clásico Cruceño
        disputado
        en el Tahuichi. La hinchada vibró con los goles de Arana y Suárez, consolidando su posición en el torneo de
        la
        División Profesional.
    </p>
</section>

